---
import Layout from '../layouts/Layout.astro';

// Must prerender in server output mode.
export const prerender = true;
---

<Layout title="Page Not Found" description="Sorry, the page you requested cannot be found.">
  <div class="not-found">
    <span class="error-code" aria-hidden="true">404</span>
    <h1>Page not found</h1>
    <p>Sorry, the page you requested cannot be found.</p>
    <a href="/" class="btn-back">Back to Blog</a>
  </div>
</Layout>

<style>
  .not-found {
    text-align: center;
    max-width: 480px;
    margin: 80px auto;
    padding: 40px 20px;
  }

  .error-code {
    font-family: var(--font-serif);
    font-size: 96px;
    font-weight: 700;
    line-height: 1;
    color: var(--border);
    margin-bottom: 24px;
    display: block;
  }

  .not-found h1 {
    font-size: 28px;
    margin-bottom: 16px;
  }

  .not-found p {
    font-size: 16px;
    color: var(--text-secondary);
    margin-bottom: 40px;
  }

  .btn-back {
    display: inline-block;
    background-color: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 12px 28px;
    border-radius: var(--rounded-full);
    transition: background-color 200ms ease, transform 200ms ease;
  }
  .btn-back:hover {
    background-color: #334155;
    transform: translateY(-1px);
  }
</style>


