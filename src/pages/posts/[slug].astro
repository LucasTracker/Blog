---
// Must prerender in server output mode so the post pages are static HTML.
export const prerender = true;

import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    // In Astro 7 loader-based collections, the entry identifier is post.id (not post.slug).
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);

// Format date using UTC components to avoid off-by-one from timezone shift.
// z.coerce.date() sets time to 00:00:00 UTC; toLocaleDateString in UTC-N would
// show the previous day. Using Intl.DateTimeFormat with timeZone: 'UTC' is correct.
const publishedDate = post.data.publishedAt instanceof Date
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    }).format(post.data.publishedAt)
  : '';
---

<Layout title={post.data.title} description={post.data.description}>
  <div class="post-wrapper">
    <a href="/" class="back-link">Back to Blog</a>

    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-meta">{publishedDate}</p>
      <p class="post-description">{post.data.description}</p>
    </header>

    <article class="post-content">
      <Content />
    </article>
  </div>
</Layout>

<style>
  .post-wrapper {
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 48px;
    transition: color 200ms ease;
  }
  .back-link:hover { color: var(--accent); }
  .back-link::before { content: '←'; }

  .post-header { margin-bottom: 48px; }

  .post-title {
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .post-meta {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .post-description {
    font-size: 18px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--divider);
  }

  /* Prose styles for MDX content */
  .post-content {
    margin-top: 48px;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    font-family: var(--font-serif);
    font-weight: 700;
    line-height: 1.3;
    margin-top: 48px;
    margin-bottom: 16px;
  }
  /* h1 inside post body: style like a major section heading.
     The page <h1> is .post-title; body authors should use ## for top sections.
     We style body h1 the same as h2 to prevent visual confusion if used. */
  .post-content :global(h1) { font-size: 22px; }
  .post-content :global(h2) { font-size: 22px; }
  .post-content :global(h3) { font-size: 18px; }

  .post-content :global(p) {
    margin-bottom: 24px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--on-surface);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 24px 24px;
    line-height: 1.75;
  }

  .post-content :global(li) { margin-bottom: 8px; }

  .post-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post-content :global(a:hover),
  .post-content :global(a:focus) {
    color: #334155;
  }
  .post-content :global(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--rounded-sm);
  }

  .post-content :global(strong) { font-weight: 600; color: var(--on-background); }

  .post-content :global(code) {
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
    font-size: 0.875em;
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--rounded-sm);
    padding: 2px 6px;
    color: var(--accent);
  }

  .post-content :global(pre) {
    background-color: var(--accent);
    color: #e2e8f0;
    border-radius: var(--rounded-lg);
    padding: 24px;
    overflow-x: auto;
    margin: 32px 0;
    font-size: 14px;
    line-height: 1.6;
  }
  .post-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--border);
    margin: 32px 0;
    padding: 8px 24px;
    color: var(--text-secondary);
    font-style: italic;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--divider);
    margin: 48px 0;
  }

  .post-content :global(img) {
    max-width: 100%;
    border-radius: var(--rounded-lg);
    margin: 32px 0;
  }
</style>


