---
// Must prerender in server output mode so the post pages are static HTML.
export const prerender = true;

import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    // In Astro 7 loader-based collections, the entry identifier is post.id (not post.slug).
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);

// Format date using UTC components to avoid off-by-one from timezone shift.
// z.coerce.date() sets time to 00:00:00 UTC; toLocaleDateString in UTC-N would
// show the previous day. Using Intl.DateTimeFormat with timeZone: 'UTC' is correct.
const publishedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(post.data.publishedAt);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{post.data.title} — Lucas Souza</title>
  <meta name="description" content={post.data.description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background-color: #faf9f6;
      color: #121212;
      line-height: 1.6;
    }

    .post-wrapper {
      max-width: 780px;
      margin: 0 auto;
      padding: 60px 40px;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 500;
      color: #555555;
      text-decoration: none;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 48px;
      transition: color 200ms ease;
    }
    .back-link:hover { color: #1e293b; }
    .back-link::before { content: '←'; }

    .post-header { margin-bottom: 48px; }

    .post-title {
      font-family: 'Playfair Display', Lora, Georgia, serif;
      font-size: clamp(28px, 5vw, 40px);
      font-weight: 700;
      line-height: 1.2;
      color: #121212;
      margin-bottom: 16px;
    }

    .post-meta {
      font-size: 13px;
      font-weight: 500;
      color: #777777;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .post-description {
      font-size: 18px;
      color: #555555;
      line-height: 1.6;
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid #f1f5f9;
    }

    /* Prose styles for MDX content */
    .post-content {
      margin-top: 48px;
    }

    .post-content :global(h1),
    .post-content :global(h2),
    .post-content :global(h3),
    .post-content :global(h4) {
      font-family: 'Playfair Display', Lora, Georgia, serif;
      font-weight: 700;
      line-height: 1.3;
      color: #121212;
      margin-top: 48px;
      margin-bottom: 16px;
    }
    /* h1 inside post body: style like a major section heading.
       The page <h1> is .post-title; body authors should use ## for top sections.
       We style body h1 the same as h2 to prevent visual confusion if used. */
    .post-content :global(h1) { font-size: 22px; }
    .post-content :global(h2) { font-size: 22px; }
    .post-content :global(h3) { font-size: 18px; }

    .post-content :global(p) {
      margin-bottom: 24px;
      font-size: 16px;
      line-height: 1.75;
      color: #1a1a1a;
    }

    .post-content :global(ul),
    .post-content :global(ol) {
      margin: 0 0 24px 24px;
      line-height: 1.75;
    }

    .post-content :global(li) { margin-bottom: 8px; }

    .post-content :global(a) {
      color: #1e293b;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .post-content :global(a:hover) { color: #334155; }

    .post-content :global(strong) { font-weight: 600; color: #121212; }

    .post-content :global(code) {
      font-family: 'Fira Code', 'JetBrains Mono', monospace;
      font-size: 0.875em;
      background-color: #f1f5f9;
      border: 1px solid #e2e8f0;
      border-radius: 4px;
      padding: 2px 6px;
    }

    .post-content :global(pre) {
      background-color: #1e293b;
      color: #e2e8f0;
      border-radius: 12px;
      padding: 24px;
      overflow-x: auto;
      margin: 32px 0;
      font-size: 14px;
      line-height: 1.6;
    }
    .post-content :global(pre code) {
      background: none;
      border: none;
      padding: 0;
      font-size: inherit;
      color: inherit;
    }

    .post-content :global(blockquote) {
      border-left: 3px solid #e2e8f0;
      margin: 32px 0;
      padding: 8px 24px;
      color: #555555;
      font-style: italic;
    }

    .post-content :global(hr) {
      border: none;
      border-top: 1px solid #f1f5f9;
      margin: 48px 0;
    }

    .post-content :global(img) {
      max-width: 100%;
      border-radius: 12px;
      margin: 32px 0;
    }

    @media (max-width: 768px) {
      .post-wrapper { padding: 40px 20px; }
    }
  </style>
</head>
<body>
  <main class="post-wrapper">
    <a href="/" class="back-link">Back to Blog</a>

    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-meta">{publishedDate}</p>
      <p class="post-description">{post.data.description}</p>
    </header>

    <article class="post-content">
      <Content />
    </article>
  </main>
</body>
</html>
